# Groq (free LLM API) key — get yours at https://console.groq.com
# No credit card required. Free tier is generous for local use.
GROQ_API_KEY=

# Optional: change the backend port (default 3001)
# PORT=3001

# Rate limit for /chat endpoint (requests per minute, default 20)
# CHAT_RATE_LIMIT=20

# News cache TTL in milliseconds (default 10 minutes)
# CACHE_TTL_MS=600000

# Max articles to keep in cache (default 120)
# MAX_ARTICLES=120

# Groq model to use (default llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Number of articles to inject as chat context (default 6)
# GROQ_TOP_K=6
